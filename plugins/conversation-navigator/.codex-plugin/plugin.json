    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "defaultPrompt": [
      "开启对话导航，用理性推演模式提供 3 个下一步建议。",
      "开启对话导航，用创意脑暴模式每轮提供 5 个不同方向。",
      "开启对话导航，用感性共鸣模式提供 4 个关注受众感受的建议。"
    ],
    "brandColor": "#16875F",
    "composerIcon": "./assets/icon.svg",
    "logo": "./assets/logo.svg",
    "logoDark": "./assets/logo-dark.svg",
