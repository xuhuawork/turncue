  "mcpServers": "./.mcp.json",
  "interface": {
    "displayName": "对话导航",
    "shortDescription": "用可编辑建议引导每一轮对话",
    "longDescription": "安装并信任 Stop Hook 后，回答完成时自动追加中文下一步卡片。可切换创意脑暴、理性推演和感性共鸣三种导航性格，并选择 3–5 个后续方向；点击后可以编辑，再发送回当前对话。",
